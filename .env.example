# Google Cloud の OAuth クライアントID（Google Drive への保存に使用）
# 詳しくは README の「Google Drive連携の初期設定」を参照
VITE_GOOGLE_CLIENT_ID=
# Google Cloud の APIキー（「Driveから選ぶ」の Google Picker に使用）
VITE_GOOGLE_API_KEY=
# 表紙画像を置く Google Drive フォルダのID（未設定時は既定のフォルダ）
VITE_DRIVE_COVER_FOLDER_ID=
# Google Cloud のプロジェクト番号（保存先フォルダへのアクセス許可に使用）
VITE_GOOGLE_APP_ID=
# 本棚データを保存する Google Drive フォルダのID（未設定時は既定のフォルダ）
VITE_DRIVE_DATA_FOLDER_ID=
# 分類マップのEmbedding・表紙からの自動入力に使うAPIキー（サーバー側だけで使用。VITE_ を付けないこと）。どちらか一方を設定
GEMINI_API_KEY=
OPENAI_API_KEY=
# Embeddingのモデルを変える場合だけ設定（既定: gemini-embedding-001 / text-embedding-3-small）
EMBEDDING_MODEL=
# 表紙の読み取りに使うモデルを変える場合だけ設定（既定: gemini-flash-latest / gpt-4.1-mini）
VISION_MODEL=
